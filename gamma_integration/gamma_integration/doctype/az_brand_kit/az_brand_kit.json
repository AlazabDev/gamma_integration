{
  "doctype": "DocType",
  "name": "AZ Brand Kit",
  "module": "Gamma Integration",
  "issingle": 1,
  "field_order": [
    "identity_section",
    "brand_name",
    "legal_name",
    "website",
    "logo",
    "logo_dark",
    "favicon",
    "colors_section",
    "primary_color",
    "accent_color",
    "surface_color",
    "text_color",
    "border_color",
    "typography_section",
    "font_family_latin",
    "font_family_arabic",
    "heading_weight",
    "body_size",
    "print_section",
    "paper_size",
    "print_language",
    "show_product_images",
    "show_qr",
    "footer_note",
    "contact_section",
    "contact_address",
    "contact_phone",
    "contact_email",
    "tax_id",
    "bank_section",
    "bank_name",
    "bank_account_name",
    "bank_account_number",
    "bank_swift"
  ],
  "fields": [
    {
      "fieldname": "identity_section",
      "label": "Identity",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "brand_name",
      "label": "Brand Name",
      "fieldtype": "Data",
      "default": "Alazab"
    },
    {
      "fieldname": "legal_name",
      "label": "Legal Name",
      "fieldtype": "Data"
    },
    {
      "fieldname": "website",
      "label": "Website",
      "fieldtype": "Data",
      "default": "https://al-azab.co"
    },
    {
      "fieldname": "logo",
      "label": "Primary Logo",
      "fieldtype": "Attach Image"
    },
    {
      "fieldname": "logo_dark",
      "label": "Alternative Logo",
      "fieldtype": "Attach Image"
    },
    {
      "fieldname": "favicon",
      "label": "Favicon",
      "fieldtype": "Attach Image"
    },
    {
      "fieldname": "colors_section",
      "label": "Colors",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "primary_color",
      "label": "Primary Navy",
      "fieldtype": "Data",
      "default": "#030957"
    },
    {
      "fieldname": "accent_color",
      "label": "Accent Gold",
      "fieldtype": "Data",
      "default": "#FFB900"
    },
    {
      "fieldname": "surface_color",
      "label": "Light Surface",
      "fieldtype": "Data",
      "default": "#F8F8F8"
    },
    {
      "fieldname": "text_color",
      "label": "Text Color",
      "fieldtype": "Data",
      "default": "#170D02"
    },
    {
      "fieldname": "border_color",
      "label": "Border Color",
      "fieldtype": "Data",
      "default": "#E7E7E7"
    },
    {
      "fieldname": "typography_section",
      "label": "Typography",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "font_family_latin",
      "label": "Latin Font",
      "fieldtype": "Select",
      "options": "Arial\nInter\nLiberation Sans",
      "default": "Arial"
    },
    {
      "fieldname": "font_family_arabic",
      "label": "Arabic Font",
      "fieldtype": "Select",
      "options": "Noto Sans Arabic\nCairo\nTahoma",
      "default": "Noto Sans Arabic"
    },
    {
      "fieldname": "heading_weight",
      "label": "Heading Weight",
      "fieldtype": "Select",
      "options": "600\n700\n800",
      "default": "800"
    },
    {
      "fieldname": "body_size",
      "label": "Base Font Size (px)",
      "fieldtype": "Int",
      "default": "11"
    },
    {
      "fieldname": "print_section",
      "label": "Print Defaults",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "paper_size",
      "label": "Paper Size",
      "fieldtype": "Select",
      "options": "A4\nLetter",
      "default": "A4"
    },
    {
      "fieldname": "print_language",
      "label": "Default Print Language",
      "fieldtype": "Select",
      "options": "ar\nen",
      "default": "ar"
    },
    {
      "fieldname": "show_product_images",
      "label": "Show Product Images",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "show_qr",
      "label": "Show QR on Documents",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "footer_note",
      "label": "Footer Note",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "contact_section",
      "label": "Contact",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "contact_address",
      "label": "Address",
      "fieldtype": "Small Text",
      "default": "8 Street 500, New Maadi, Cairo"
    },
    {
      "fieldname": "contact_phone",
      "label": "Phone",
      "fieldtype": "Data"
    },
    {
      "fieldname": "contact_email",
      "label": "Email",
      "fieldtype": "Data",
      "default": "sales@alazab.com"
    },
    {
      "fieldname": "tax_id",
      "label": "Tax ID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "bank_section",
      "label": "Bank Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "bank_name",
      "label": "Bank Name",
      "fieldtype": "Data"
    },
    {
      "fieldname": "bank_account_name",
      "label": "Account Name",
      "fieldtype": "Data"
    },
    {
      "fieldname": "bank_account_number",
      "label": "Account Number",
      "fieldtype": "Data"
    },
    {
      "fieldname": "bank_swift",
      "label": "SWIFT / BIC",
      "fieldtype": "Data"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}